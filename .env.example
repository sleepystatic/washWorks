# ─────────────────────────────────────────────────────────────────────────
# Wash Works — environment template
# Copy this file to .env for local dev (never commit the real .env).
# On Render, set these in the service's Environment tab, not in a file.
# ─────────────────────────────────────────────────────────────────────────

# Flask session signing key. Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me


# ── Contact-form email ────────────────────────────────────────────────────
# How the form behaves: it saves every submission to data/submissions.jsonl
# FIRST, then tries to email a notification. If nothing below is configured,
# the form still works and still saves the lead — it just logs that it
# couldn't send (that's the T-5 design: a mail outage never loses a lead).
#
# notify() tries the HTTP API block first, then falls back to SMTP. You only
# need to fill in ONE of the two sections below - API is the one that actually
# works on Render's free tier (see the warning under SMTP).

# ---- Mailgun HTTP API (recommended - use this one) -----------------------
# A plain HTTPS POST on port 443. Works on every plan, every host, always -
# no PaaS blocks 443, because that would break the platform itself.
#
#   MAILGUN_API_KEY  → Mailgun → Settings → API Keys → "Private API key"
#   MAILGUN_DOMAIN   → the domain you verified in Mailgun, e.g. mg.washworkscws.com
#   MAILGUN_API_BASE → US (default): https://api.mailgun.net/v3
#                      EU: https://api.eu.mailgun.net/v3
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.washworkscws.com
MAILGUN_API_BASE=https://api.mailgun.net/v3

# ---- SMTP (fallback / portable to non-Render hosts) -----------------------
# ⚠ Render's FREE web services block ALL outbound SMTP ports - 25, 465, AND
#   587 - at the network level, confirmed against Render's own changelog
#   (render.com/changelog/free-web-services-will-no-longer-allow-outbound-
#   traffic-to-smtp-ports). On Free, this whole section will time out no
#   matter how correct the values are. It works fine on a paid Render plan,
#   or on any other host. Use the API block above unless you know this
#   service is on a paid plan.
#
# Where each value lives in Mailgun:
#   Send → Domain settings → (your domain) → SMTP → "SMTP credentials"
# ⚠ Two different Mailgun secrets exist — you want the SMTP password here, NOT
#   the HTTP API key above, and NOT your Mailgun account login password.

# SMTP host for your Mailgun region. US: smtp.mailgun.org  •  EU: smtp.eu.mailgun.org
MAIL_SERVER=smtp.mailgun.org
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# The SMTP login Mailgun shows for the domain, e.g. postmaster@mg.washworkscws.com
MAIL_USERNAME=postmaster@mg.washworkscws.com

# The SMTP password for that login (reset it in the SMTP credentials panel if
# you don't have it). Leave blank locally to keep the form in "save-only" mode.
MAIL_PASSWORD=

# ---- Shared by both paths --------------------------------------------------
# The From: address. MUST be on your verified Mailgun sending domain or the
# mail gets filtered (T-4). A display name is fine:
MAIL_DEFAULT_SENDER=Wash Works Website <noreply@mg.washworkscws.com>

# Where leads are delivered — the real inbox a human reads. This is the
# washworkscws.com address still pending confirmation (C-7). If left blank, the
# app falls back to company.email in content/site.json (also still null).
CONTACT_TO=


# ── Host canonicalisation ────────────────────────────────────────────────
CANONICAL_HOST=washworkscws.com
# If the lost domain washworkscw.com (S-2) is ever reclaimed, list it here
# (comma-separated for several) and it will 301 to the canonical host.
LEGACY_HOSTS=


# ── Staging ──────────────────────────────────────────────────────────────
# Set to 1 on the Render STAGING service. It blocks indexing (O-1) and silences
# the "advertising Licensed without the CSLB number" compliance warning until
# the public launch. Leave blank/0 on production.
NOINDEX=