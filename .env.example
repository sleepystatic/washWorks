# Copy to .env for local dev. Never commit the real .env.
SECRET_KEY=change-me

# Contact form email (T-4 / C-7). Send FROM an address on washworkscws.com,
# not a personal Gmail. Add the provider to the existing SPF record - do not
# create a second SPF record.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
CONTACT_FROM=noreply@washworkscws.com
CONTACT_TO=

# Host canonicalisation. If washworkscw.com (the lost domain, S-2) is reclaimed,
# list it here comma-separated and it will 301 to the canonical host.
CANONICAL_HOST=washworkscws.com
LEGACY_HOSTS=

# Set to 1 on the Render staging service so it is never indexed (O-1).
NOINDEX=
