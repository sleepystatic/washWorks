# ─────────────────────────────────────────────────────────────────────────
# Wash Works — environment template
# Copy this file to .env for local dev (never commit the real .env).
# On Render, set these in the service's Environment tab, not in a file.
# ─────────────────────────────────────────────────────────────────────────

# Flask session signing key. Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me


# ── Contact-form email (Resend) ──────────────────────────────────────────
# How the form behaves: it saves every submission to data/submissions.jsonl
# FIRST, then emails a notification via Resend. If the keys below are blank,
# the form still works and still saves the lead — it just logs that it
# couldn't send (that's the T-5 design: a mail outage never loses a lead).
#
# Resend is a plain HTTPS POST on port 443, so it is unaffected by the
# outbound-SMTP-port blocking that free PaaS tiers (Render included) impose.
#
# Setup:
#   1. Sign up at resend.com. Add washworkscws.com (or a subdomain like
#      mail.washworkscws.com) as a sending domain and add the DNS records
#      Resend gives you (SPF + DKIM, sometimes an MX for return-path).
#   2. RESEND_API_KEY → Resend dashboard → API Keys → Create API Key.
#      On Render you can also add Resend via the native integration, which
#      sets this var for you.
RESEND_API_KEY=

# The From: address. MUST be on the domain you verified in Resend, or the
# mail is filtered as spam (T-4). A display name is fine:
MAIL_DEFAULT_SENDER=Wash Works Website <noreply@washworkscws.com>

# Where leads are delivered — the real inbox a human reads. This is the
# washworkscws.com address still pending confirmation (C-7). If left blank, the
# app falls back to company.email in content/site.json (also still null).
CONTACT_TO=


# ── Host canonicalisation ────────────────────────────────────────────────
CANONICAL_HOST=washworkscws.com
# If the lost domain washworkscw.com (S-2) is ever reclaimed, list it here
# (comma-separated for several) and it will 301 to the canonical host.
LEGACY_HOSTS=


# ── Staging ──────────────────────────────────────────────────────────────
# Set to 1 on the Render STAGING service. It blocks indexing (O-1) and silences
# the "advertising Licensed without the CSLB number" compliance warning until
# the public launch. Leave blank/0 on production.
NOINDEX=